# Copy this file to .env for local Compose.
# For production, use the same variable contract as the PRODUCTION_ENV_FILE
# GitHub Environment secret. Set real values only in that protected secret;
# the deployment workflow writes it to /opt/support-assistant/.env.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_SITE_URL=http://localhost:8080
LLM_RATE_LIMIT_PER_MINUTE=10
LLM_RATE_LIMIT_PER_DAY=20
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=support-assistant-backend
ENVIRONMENT=development

# Production overrides:
# OPENROUTER_SITE_URL=https://support.example.com
# ENVIRONMENT=production
# Image digests and deployment topology are managed separately by the workflow.

# For public deployment, set exact trusted proxy IPs/CIDRs. Never use "*".
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
