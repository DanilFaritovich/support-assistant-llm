# Copy this file to .env. The key is consumed only by the backend container.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_SITE_URL=http://localhost:8080
LLM_RATE_LIMIT_PER_MINUTE=10
LLM_RATE_LIMIT_PER_DAY=20
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=support-assistant-backend
ENVIRONMENT=development

# For public deployment, set exact trusted proxy IPs/CIDRs. Never use "*".
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
