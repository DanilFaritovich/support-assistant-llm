# Usually overridden by Docker Compose.
# DATABASE_URL=sqlite+aiosqlite:////app/data/app.db

# Required for routing and drafting. Never expose this value to the frontend.
OPENROUTER_API_KEY=

# Only openrouter/free and model IDs ending in :free are accepted.
OPENROUTER_MODELS=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
LLM_RATE_LIMIT_PER_MINUTE=10
LLM_RATE_LIMIT_PER_DAY=20

# Optional attribution header sent to OpenRouter.
OPENROUTER_SITE_URL=
